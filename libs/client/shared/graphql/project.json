{
  "name": "client-shared-graphql",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/client/shared/graphql/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:graphql"],
  "// targets": "to see all targets run: nx show project client-shared-graphql --web",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/client/shared/graphql"
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "../../../coverage/libs/client/shared/graphql"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/client/shared/graphql/**/*.{ts,tsx,js,jsx}"]
      }
    }
  }
}
