    createProduct(input: $input) {
      id
      name
      sku
      description
      descriptions {
        id
        productId
        languageId
        language {
          id
          code
          name
          nativeName
          isRTL
        }
        description
      }
      categories {
        id
        name
      }
      brand {
        id
        name
        slug
      }
      brandId
    }
