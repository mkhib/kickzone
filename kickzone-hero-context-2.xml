describe('AdminProducts', () => {
  beforeEach(() => {
    vi.clearAllMocks();
    mockUseAdminsProductsStore.mockReturnValue(createStoreState());
    mockUseProductsQuery.mockReturnValue({
      products,
      loading: false,
      error: null,
      loadMore: mockLoadMore,
      hasNextPage: true,
      totalCount: 2,
      refetch: mockRefetch,
