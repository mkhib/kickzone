      } as unknown as Order;

      orderRepository.findOne.mockResolvedValue(order);

      await expect(
        service.setPaymentIntent({ orderId, authority: 'A_NEW', amount: 1 }),
      ).rejects.toThrow(BadRequestException);
      await expect(
        service.setPaymentIntent({ orderId, authority: 'A_NEW', amount: 1 }),
