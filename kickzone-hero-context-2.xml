  @Query(() => [SiteLanguage])
  async siteLanguages(
    @Args('activeOnly', { type: () => Boolean, nullable: true })
    activeOnly?: boolean
  ): Promise<SiteLanguage[]> {
    return this.siteLanguageService.findAll(activeOnly ?? true);
  }

  @Query(() => SiteLanguage, { nullable: true })
  async siteLanguage(
