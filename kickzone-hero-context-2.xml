      zipCode: '10001',
      country: 'USA',
      sellerId,
      status: OrderStatus.PENDING,
      stockReserved: false,
      subtotal,
      shippingCost,
      total: subtotal + shippingCost,
      sellerStoreName: s.storeName,
      sellerPhone: s.phone,
      sellerAddress: s.address,
