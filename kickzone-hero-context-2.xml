        id
        code
        name
        nativeName
        isRTL
      }
      description
    }
    categories {
      ...CategoryFields
    }
    brand {
      ...BrandFields
    }
    brandId
    productInfos {
      ...ProductInfoFields
    }
    sellerProducts {
      id
      productInfoId
      price
      discount
      stockQuantity
      boxLess
      seller {
        id
        storeName
        shippingFee
        user {
          id
          name
        }
      }
      productInfo {
        ...ProductInfoFields
      }
    }
  }
  ${CATEGORY_FRAGMENT}
  ${BRAND_FRAGMENT}
  ${PRODUCT_INFO_FRAGMENT}
`;

export const CREATE_PRODUCT = gql`
