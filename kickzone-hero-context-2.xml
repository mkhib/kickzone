  });

  describe('Apparel and Footwear invalid sizes unchanged', () => {
    it('rejects invalid Apparel size with existing apparel message', async () => {
      const adminUser = {
        id: 1,
        role: UserRole.ADMIN,
        username: 'admin',
      } as unknown as User;

      const targetProduct: Product = {
        id: 400,
        name: 'Test Shirt',
        sku: 'SHIRT-001',
        categories: [],
        productInfos: [],
        sellerProducts: [],
        archived: false,
