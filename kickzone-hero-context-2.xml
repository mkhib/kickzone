                background: 'var(--ink-2)',
                transform: 'scale(1.01)',
              },
              '&:active': {
                transform: 'scale(0.97)',
              },
            }}
          >
            {addedAll ? 'هر سه به سبد اضافه شدند' : 'افزودن هر سه به سبد'}
          </Button>
        </Box>
      </Box>
