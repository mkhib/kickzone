<file path="libs/client/shared/graphql/src/lib/fragments.ts">
import { gql } from '@apollo/client';

// Basic shared fragments for common types
export const COLOR_FRAGMENT = gql`
  fragment ColorFields on Color {
    id
    name
    hexCode
  }
`;

export const CATEGORY_FRAGMENT = gql`
  fragment CategoryFields on Category {
    id
    name
    slug
  }
`;

export const BRAND_FRAGMENT = gql`
  fragment BrandFields on Brand {
    id
    name
    slug
  }
`;

export const USER_FRAGMENT = gql`
  fragment UserFields on User {
    id
    name
    email
    role
  }
`;

export const PRODUCT_INFO_FRAGMENT = gql`
  fragment ProductInfoFields on ProductInfo {
    id
    size
    sizeKind
    colors {
      ...ColorFields
    }
    weight
    images
  }
  ${COLOR_FRAGMENT}
`;

// Basic product fragment (without seller products - for general use)
export const BASIC_PRODUCT_FRAGMENT = gql`
  fragment BasicProductFields on Product {
    id
    name
    sku
    archived
    description
    categories {
      ...CategoryFields
    }
    brand {
      ...BrandFields
    }
    brandId
    productInfos {
      ...ProductInfoFields
    }
  }
  ${CATEGORY_FRAGMENT}
  ${BRAND_FRAGMENT}
  ${PRODUCT_INFO_FRAGMENT}
`;
</file>

<file path="libs/client/shared/graphql/src/lib/variant-colors.ts">
import { KickzoneGraphqlTypes } from '@kickzone-workspace/codegen';

type ColorLike = Pick<KickzoneGraphqlTypes.Color, 'name' | 'hexCode'> & {
  id?: number;
};

export function formatVariantColorNames(
  colors?: ColorLike[] | null,
  fallback = ''
): string {
  if (!colors?.length) {
    return fallback;
  }
  return colors.map((c) => c.name || c.hexCode).join(' / ');
}

export function serializeVariantColorHexes(
  colors?: ColorLike[] | null
): string | null {
  if (!colors?.length) {
    return null;
  }
  return colors.map((c) => c.hexCode).join(',');
}

export function parseColorHexes(color?: string | null): string[] {
  if (!color) {
    return [];
  }
  return color
    .split(',')
    .map((part) => part.trim())
    .filter(Boolean);
}
</file>

