<file path="libs/client/admins/graphql/src/lib/fragments.ts">
import { gql } from '@apollo/client';
import {
  CATEGORY_FRAGMENT,
  USER_FRAGMENT,
  PRODUCT_INFO_FRAGMENT,
} from '@kickzone-workspace/client-shared-graphql';

// SellerInfo fragment (for admin side)
export const SELLER_INFO_FRAGMENT = gql`
  fragment SellerInfoFields on SellerInfo {
    id
    storeName
    phone
    address
    isActive
    canManageCatalog
    shippingPaymentMode
    user {
      ...UserFields
    }
  }
  ${USER_FRAGMENT}
`;

// SellerProduct fragment (for admin side - includes seller info)
export const ADMIN_SELLER_PRODUCT_FRAGMENT = gql`
  fragment AdminSellerProductFields on SellerProduct {
    id
    price
    costPrice
    discount
    stockQuantity
    seller {
      ...SellerInfoFields
    }
    productInfo {
      ...ProductInfoFields
    }
  }
  ${SELLER_INFO_FRAGMENT}
  ${PRODUCT_INFO_FRAGMENT}
`;

// Product fragment (for admin side - includes all seller products with seller info)
export const ADMIN_PRODUCT_FRAGMENT = gql`
  fragment AdminProductFields on Product {
    id
    name
    sku
    archived
    description
    categories {
      ...CategoryFields
    }
    productInfos {
      ...ProductInfoFields
    }
    sellerProducts {
      ...AdminSellerProductFields
    }
  }
  ${CATEGORY_FRAGMENT}
  ${PRODUCT_INFO_FRAGMENT}
  ${ADMIN_SELLER_PRODUCT_FRAGMENT}
`;

// Product fragment for admin product management (when editing products)
export const ADMIN_PRODUCT_MANAGEMENT_FRAGMENT = gql`
  fragment AdminProductManagementFields on Product {
    id
    name
    sku
    archived
    description
    categories {
      ...CategoryFields
    }
    productInfos {
      ...ProductInfoFields
    }
  }
  ${CATEGORY_FRAGMENT}
  ${PRODUCT_INFO_FRAGMENT}
`;
</file>

<file path="libs/client/customers/graphql/src/lib/queries.ts">
import { gql } from '@apollo/client';

export const GET_CART_QUERY = gql`
  query GetCart {
    myCart {
      id
      userId
      subtotal
      total
      createdAt
      updatedAt
      items {
        id
        cartId
        productId
        productName
        productImage
        quantity
        unitPrice
        totalPrice
        color
        size
        sellerId
        productInfoId
        sellerProductId
        availableStock
      }
    }
  }
`;

export const GET_SELLERS_BY_IDS_QUERY = gql`
  query GetSellersByIds($filter: SellerFilterInput) {
    sellers(filter: $filter) {
      edges {
        node {
          id
          shippingFee
          shippingPaymentMode
        }
      }
    }
  }
`;

// Alias for backward compatibility with existing code
export const GET_MY_CART_QUERY = GET_CART_QUERY;

export const GET_PRODUCTS_QUERY = gql`
  query GetProducts($filter: ProductFilterInput) {
    products(filter: $filter) {
      edges {
        cursor
        node {
          id
          name
          sku
          description
          archived
          productInfos {
            id
            size
            sizeKind
            colors {
              id
              name
              hexCode
            }
            weight
            images
          }
          categories {
            id
            name
            slug
          }
          sellerProducts {
            id
            price
            costPrice
            discount
            stockQuantity
            productInfoId
            boxLess
            seller {
              id
              shippingFee
              shippingPaymentMode
            }
          }
        }
      }
      pageInfo {
        hasNextPage
        hasPreviousPage
        endCursor
      }
      totalCount
    }
  }
`;

export const DISTINCT_PRODUCT_SIZES_QUERY = gql`
  query DistinctProductSizes($sizeKind: SizeKind) {
    distinctProductSizes(sizeKind: $sizeKind)
  }
`;

export const GET_MY_ORDERS_QUERY = gql`
  query GetMyOrders($first: Int = 10, $after: String) {
    myOrders(first: $first, after: $after) {
      id
      orderNumber
      customerEmail
      customerPhone
      customerName
      shippingAddress
      city
      state
      zipCode
      country
      status
      subtotal
      shippingCost
      total
      notes
      trackingNumber
      createdAt
      updatedAt
      sellerPhone
      sellerAddress
      shippingMethod
      shippingPaymentMode
      items {
        id
        productId
        productName
        productImage
        quantity
        unitPrice
        totalPrice
        color
        size
        originalPrice
        discountPercentage
        productInfoId
        sellerProductId
      }
    }
  }
`;

/**
 * Calculate shipping cost using smart shipping logic
 * Returns total shipping cost with breakdown per seller
 */
export const CALCULATE_SHIPPING_COST_QUERY = gql`
  query CalculateShippingCost(
    $cartSubtotal: Float!
    $sellerShippingFees: [SellerShippingInfoInput!]!
  ) {
    calculateShippingCost(
      cartSubtotal: $cartSubtotal
      sellerShippingFees: $sellerShippingFees
    ) {
      totalShippingCost
      freeShippingApplied
      strategyUsed
      shippingBreakdown {
        sellerId
        originalFee
        appliedFee
      }
    }
  }
`;
</file>

<file path="libs/server/entities/src/lib/order.entity.ts">
import {
  Field,
  Float,
  ID,
  Int,
  ObjectType,
  registerEnumType,
} from '@nestjs/graphql';
import {
  Column,
  CreateDateColumn,
  Entity,
  JoinColumn,
  ManyToOne,
  OneToMany,
  PrimaryGeneratedColumn,
  UpdateDateColumn,
} from 'typeorm';
import { Product } from './product.entity';
import { SellerInfo, ShippingPaymentMode } from './seller-info.entity';

export enum OrderStatus {
  PENDING = 'PENDING',
  CONFIRMED = 'CONFIRMED',
  PROCESSING = 'PROCESSING',
  SHIPPED = 'SHIPPED',
  DELIVERED = 'DELIVERED',
  CANCELLED = 'CANCELLED',
  REFUNDED = 'REFUNDED',
}

registerEnumType(OrderStatus, {
  name: 'OrderStatus',
});

export enum OrderShippingMethod {
  VIP = 'vip',
  EXPRESS = 'express',
  PICKUP = 'pickup',
}

registerEnumType(OrderShippingMethod, {
  name: 'OrderShippingMethod',
});

@ObjectType()
@Entity('orders')
export class Order {
  @Field(() => ID)
  @PrimaryGeneratedColumn('uuid')
  id: string;

  @Field(() => String)
  @Column()
  orderNumber: string;

  @Field(() => String)
  @Column()
  customerEmail: string;

  @Field(() => String)
  @Column()
  customerPhone: string;

  @Field(() => String)
  @Column()
  customerName: string;

  @Field(() => String)
  @Column()
  shippingAddress: string;

  @Field(() => String)
  @Column()
  city: string;

  @Field(() => String)
  @Column()
  state: string;

  @Field(() => String)
  @Column()
  zipCode: string;

  @Field(() => String)
  @Column()
  country: string;

  @Field(() => OrderStatus)
  @Column({
    type: 'enum',
    enum: OrderStatus,
    default: OrderStatus.PENDING,
  })
  status: OrderStatus;

  @Field(() => Boolean, { defaultValue: false })
  @Column({ type: 'boolean', default: false })
  stockReserved!: boolean;

  @Field(() => Float)
  @Column('decimal', { precision: 10, scale: 2 })
  subtotal: number;

  @Field(() => Float)
  @Column('decimal', { precision: 10, scale: 2 })
  shippingCost: number;

  @Field(() => String, { defaultValue: 'vip' })
  @Column({ type: 'varchar', length: 20, default: 'vip' })
  shippingMethod?: string;

  @Field(() => ShippingPaymentMode, {
    defaultValue: ShippingPaymentMode.PAY_ON_DELIVERY,
  })
  @Column({
    type: 'enum',
    enum: ShippingPaymentMode,
    default: ShippingPaymentMode.PAY_ON_DELIVERY,
  })
  shippingPaymentMode?: ShippingPaymentMode;

  @Field(() => Float)
  @Column('decimal', { precision: 10, scale: 2 })
  total: number;

// Payment metadata for verification
@Field(() => Float, { nullable: true })
@Column('decimal', { precision: 12, scale: 2, nullable: true })
paymentAmount?: number | null;

@Field(() => String, { nullable: true })
@Column({ nullable: true })
paymentCurrency?: string | null;

@Field(() => String, { nullable: true })
@Column({ nullable: true })
paymentAuthority?: string | null;

  // Seller snapshot fields - preserve seller info at order time
  @Field(() => String, { nullable: true })
  @Column({ nullable: true })
  sellerStoreName?: string;

  @Field(() => String, { nullable: true })
  @Column({ nullable: true })
  sellerPhone?: string;

  @Field(() => String, { nullable: true })
  @Column({ nullable: true })
  sellerAddress?: string;

  @Field(() => String, { nullable: true })
  @Column({ nullable: true })
  notes?: string;

  @Field(() => String, { nullable: true })
  @Column({ nullable: true })
  trackingNumber?: string;

  @Field(() => Date, { nullable: true })
  @Column({ type: 'timestamp', nullable: true })
  paymentVerifiedAt?: Date | null;

  @Field(() => Date)
  @CreateDateColumn()
  createdAt: Date;

  @Field(() => Date)
  @UpdateDateColumn()
  updatedAt: Date;

  @Field(() => Int)
  @Column()
  sellerId: number;

  @ManyToOne(() => SellerInfo, { onDelete: 'CASCADE' })
  @JoinColumn({ name: 'sellerId' })
  seller: SellerInfo;

  @OneToMany(() => OrderItem, (orderItem) => orderItem.order, { cascade: true })
  items: OrderItem[];
}

@ObjectType()
@Entity('order_items')
export class OrderItem {
  @Field(() => ID)
  @PrimaryGeneratedColumn('uuid')
  id: string;

  @Field(() => String)
  @Column()
  orderId: string;

  @Field(() => String)
  @Column()
  productId: string;

  @Field(() => String)
  @Column()
  productName: string;

  @Field(() => String, { nullable: true })
  @Column({ nullable: true })
  productImage?: string;

  @Field(() => Int)
  @Column()
  quantity: number;

  @Field(() => Float)
  @Column('decimal', { precision: 10, scale: 2 })
  unitPrice: number;

  @Field(() => Float)
  @Column('decimal', { precision: 10, scale: 2 })
  totalPrice: number;

  @Field(() => String, { nullable: true })
  @Column({ nullable: true })
  color?: string;

  @Field(() => String, { nullable: true })
  @Column({ nullable: true })
  size?: string;

  @Field(() => String, { nullable: true })
  @Column({ nullable: true })
  sellerProductId?: string;

  // Product pricing snapshot fields - preserve pricing details at order time
  @Field(() => Float, { nullable: true })
  @Column('decimal', { precision: 10, scale: 2, nullable: true })
  originalPrice?: number;

  @Field(() => Float, { nullable: true })
  @Column('decimal', { precision: 5, scale: 2, nullable: true })
  discountPercentage?: number;

  @Field(() => Int, { nullable: true })
  @Column({ nullable: true })
  productInfoId?: number;

  @ManyToOne(() => Order, (order) => order.items, { onDelete: 'CASCADE' })
  @JoinColumn({ name: 'orderId' })
  order: Order;

  @ManyToOne(() => Product, { onDelete: 'CASCADE' })
  @JoinColumn({ name: 'productId' })
  product: Product;
}
</file>

