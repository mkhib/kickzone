<file path="libs/shared/validation/src/lib/query.spec.ts">
import {
  cursorSchema,
  optionalIdSchema,
  paginationFirstSchema,
  productFilterSchema,
  sellerFilterSchema,
} from './query';

const ok = (s: { safeParse: (v: unknown) => { success: boolean } }, v: unknown) => s.safeParse(v).success;

describe('query argument schemas', () => {
  it('bounds page sizes and cursors', () => {
    for (const n of [1, 10, 100, 200]) expect(ok(paginationFirstSchema, n)).toBe(true);
    for (const n of [0, -1, 201, 2.5]) expect(ok(paginationFirstSchema, n)).toBe(false);
    expect(ok(cursorSchema, undefined)).toBe(true);
    expect(ok(cursorSchema, 'x'.repeat(501))).toBe(false);
    expect(ok(optionalIdSchema, null)).toBe(true);
    expect(ok(optionalIdSchema, ' ')).toBe(false);
  });

  it('accepts the filters the storefront sends today', () => {
    expect(ok(productFilterSchema, undefined)).toBe(true);
    expect(
      ok(productFilterSchema, {
        first: 200,
        onlyInStock: true,
        onlyWithSellers: true,
        archivedStatus: 'ACTIVE',
        categorySlugs: ['t-shirts', 'sneakers'],
        brands: ['nike'],
        sortOrder: 'desc',
        productInfoFilter: { size: ['42'], colorId: [1, 2] },
      })
    ).toBe(true);
    expect(ok(sellerFilterSchema, { ids: [1, 2], first: 100 })).toBe(true);
  });

  it('rejects oversized filter arrays and bad sort orders', () => {
    const many = Array.from({ length: 101 }, (_, i) => i);
    expect(ok(productFilterSchema, { ids: many })).toBe(false);
    expect(ok(productFilterSchema, { productInfoFilter: { colorId: many } })).toBe(false);
    expect(ok(productFilterSchema, { sortOrder: 'sideways' })).toBe(false);
    expect(ok(sellerFilterSchema, { ids: many })).toBe(false);
  });
});
</file>

<file path="libs/shared/validation/src/lib/query.ts">
import { z } from 'zod';
import { idSchema } from './primitives';

/** Query argument limits (largest client page size today is 200). */
export const QUERY_LIMITS = {
  first: { min: 1, max: 200 },
  cursor: { max: 500 },
  filterArray: { max: 100 },
  text: { max: 200 },
  sort: { max: 50 },
} as const;

export const paginationFirstSchema = z
  .number()
  .int()
  .min(QUERY_LIMITS.first.min)
  .max(QUERY_LIMITS.first.max);
export const cursorSchema = z.string().max(QUERY_LIMITS.cursor.max).nullish();
export const optionalIdSchema = idSchema.nullish();

const text = z.string().max(QUERY_LIMITS.text.max);
const list = <T extends z.ZodType>(item: T) => z.array(item).max(QUERY_LIMITS.filterArray.max).nullish();
const flag = z.boolean().nullish();

export const productInfoFilterSchema = z.object({
  size: list(text),
  sizeKind: z.string().nullish(),
  price: list(z.number()),
  costPrice: list(z.number()),
  colorId: list(z.number().int()),
  weight: list(z.number()),
  discount: list(z.number()),
  stockQuantity: list(z.number().int()),
});

export const productFilterSchema = z
  .object({
    category: text.nullish(),
    categorySlugs: list(text),
    brand: text.nullish(),
    brands: list(text),
    ids: list(z.number().int()),
    searchTerm: text.nullish(),
    productInfoFilter: productInfoFilterSchema.nullish(),
    categoryIds: list(z.number().int()),
    first: paginationFirstSchema.nullish(),
    after: cursorSchema,
    categoryId: z.number().int().nullish(),
    sort: z.string().max(QUERY_LIMITS.sort.max).nullish(),
    sortOrder: z.enum(['asc', 'desc']).nullish(),
    archivedStatus: z.string().nullish(),
    sellerId: z.number().int().nullish(),
    onlyWithSellers: flag,
    onlyInStock: flag,
    onlyDiscounted: flag,
  })
  .nullish();

export const sellerFilterSchema = z
  .object({
    searchTerm: text.nullish(),
    isActive: flag,
    ids: list(z.number().int()),
    first: paginationFirstSchema.nullish(),
    after: cursorSchema,
  })
  .nullish();
</file>

<file path="libs/shared/validation/src/lib/taxonomy.spec.ts">
import {
  categoryFormSchema,
  colorFormSchema,
  createBrandSchema,
  createColorSchema,
  createSiteLanguageSchema,
  optionalDisplayNameSchema,
  updateBrandSchema,
  updateColorSchema,
  updateSiteLanguageSchema,
} from './taxonomy';

const ok = (s: { safeParse: (v: unknown) => { success: boolean } }, v: unknown) => s.safeParse(v).success;

describe('taxonomy schemas', () => {
  it('accepts slugs built from names, including Persian ones', () => {
    expect(ok(createBrandSchema, { slug: 't-shirts', sortOrder: 0 })).toBe(true);
    expect(ok(createBrandSchema, { slug: 'کفش-ورزشی' })).toBe(true);
    expect(ok(updateBrandSchema, { id: 1, slug: null, isActive: false })).toBe(true);
  });

  it('rejects blank or spaced slugs', () => {
    expect(ok(createBrandSchema, { slug: '  ' })).toBe(false);
    expect(ok(createBrandSchema, { slug: 'a b' })).toBe(false);
    expect(ok(updateBrandSchema, { slug: 'x' })).toBe(false);
  });

  it('validates hex colors', () => {
    for (const hex of ['#fff', '#00FF00', '#1A1A1A80']) expect(ok(createColorSchema, { hexCode: hex })).toBe(true);
    for (const hex of ['red', '#12345', '00ff00']) expect(ok(updateColorSchema, { hexCode: hex })).toBe(false);
  });

  it('validates site languages', () => {
    expect(ok(createSiteLanguageSchema, { code: 'fa', name: 'Farsi', nativeName: 'فارسی', isRTL: true })).toBe(true);
    expect(ok(createSiteLanguageSchema, { code: 'pt-BR', name: 'Portuguese', nativeName: 'Português' })).toBe(true);
    expect(ok(createSiteLanguageSchema, { code: 'f', name: 'x', nativeName: 'x' })).toBe(false);
    expect(ok(updateSiteLanguageSchema, { name: '' })).toBe(false);
    expect(ok(updateSiteLanguageSchema, { isActive: false })).toBe(true);
  });

  it('validates the optional name argument and the admin modals', () => {
    expect(ok(optionalDisplayNameSchema, null)).toBe(true);
    expect(ok(optionalDisplayNameSchema, 'x'.repeat(101))).toBe(false);
    expect(ok(categoryFormSchema, { name: ' ' })).toBe(false);
    expect(ok(colorFormSchema, { name: 'Green', hexCode: '#00ff00' })).toBe(true);
    expect(ok(colorFormSchema, { name: 'Green', hexCode: 'green' })).toBe(false);
  });
});
</file>

<file path="libs/shared/validation/src/lib/taxonomy.ts">
import { z } from 'zod';

export const TAXONOMY_LIMITS = {
  slug: { max: 100 },
  name: { max: 100 },
  languageCode: { max: 10 },
} as const;

/** `#rgb`, `#rrggbb` or `#rrggbbaa`. */
export const HEX_COLOR_PATTERN = /^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/;

/** Slugs are built from names (lowercase, spaces to hyphens), so only blanks and whitespace are rejected. */
export const slugSchema = z.string().trim().min(1).max(TAXONOMY_LIMITS.slug.max).regex(/^\S+$/);
export const displayNameSchema = z.string().trim().min(1).max(TAXONOMY_LIMITS.name.max);
/** Optional translated name argument (`name`) on brand/category/color mutations. */
export const optionalDisplayNameSchema = z.string().trim().max(TAXONOMY_LIMITS.name.max).nullish();
export const hexColorSchema = z.string().trim().regex(HEX_COLOR_PATTERN);
const sortOrder = z.number().int().nullish();
const flag = z.boolean().nullish();

export const createBrandSchema = z.object({ slug: slugSchema, sortOrder });
export const updateBrandSchema = z.object({
  id: z.number().int(),
  slug: slugSchema.nullish(),
  sortOrder,
  isActive: flag,
});

export const createCategorySchema = createBrandSchema;
export const updateCategorySchema = updateBrandSchema;

export const createColorSchema = z.object({ hexCode: hexColorSchema, sortOrder });
export const updateColorSchema = z.object({ hexCode: hexColorSchema, sortOrder, isActive: flag });

export const languageCodeSchema = z
  .string()
  .trim()
  .min(2)
  .max(TAXONOMY_LIMITS.languageCode.max)
  .regex(/^[A-Za-z]{2,3}(?:[-_][A-Za-z0-9]{2,8})*$/);

export const createSiteLanguageSchema = z.object({
  code: languageCodeSchema,
  name: displayNameSchema,
  nativeName: displayNameSchema,
  isRTL: flag,
  isActive: flag,
  isDefault: flag,
});

export const updateSiteLanguageSchema = z.object({
  name: displayNameSchema.nullish(),
  nativeName: displayNameSchema.nullish(),
  isRTL: flag,
  isActive: flag,
  isDefault: flag,
});

/** Admin category modal. */
export const categoryFormSchema = z.object({ name: displayNameSchema });
/** Admin color modal. */
export const colorFormSchema = z.object({ name: displayNameSchema, hexCode: hexColorSchema });

export type CategoryFormInput = z.input<typeof categoryFormSchema>;
export type ColorFormInput = z.input<typeof colorFormSchema>;
</file>

