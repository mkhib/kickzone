<file path="libs/client/shared/graphql/src/lib/currency.mutations.ts">
import { gql } from '@apollo/client';

export const CREATE_CURRENCY = gql`
  mutation CreateCurrency($input: CreateCurrencyInput!) {
    createCurrency(input: $input) {
      id
      code
      name
      symbol
      decimalPlaces
      isActive
      isBaseCurrency
    }
  }
`;

export const UPDATE_CURRENCY = gql`
  mutation UpdateCurrency($id: Int!, $input: UpdateCurrencyInput!) {
    updateCurrency(id: $id, input: $input) {
      id
      code
      name
      symbol
      decimalPlaces
      isActive
      isBaseCurrency
    }
  }
`;

export const SET_EXCHANGE_RATE = gql`
  mutation SetExchangeRate($input: SetExchangeRateInput!) {
    setExchangeRate(input: $input) {
      id
      rate
      effectiveDate
      notes
      fromCurrency {
        code
        name
        symbol
      }
      toCurrency {
        code
        name
        symbol
      }
    }
  }
`;

export const SET_CURRENCY_PREFERENCE = gql`
  mutation SetCurrencyPreference($locale: String!, $currencyCode: String!) {
    setCurrencyPreference(locale: $locale, currencyCode: $currencyCode) {
      id
      locale
      currency {
        code
        name
        symbol
        decimalPlaces
      }
    }
  }
`;

export const DELETE_CURRENCY_PREFERENCE = gql`
  mutation DeleteCurrencyPreference($id: Int!) {
    deleteCurrencyPreference(id: $id)
  }
`;
</file>

<file path="libs/client/shared/graphql/src/lib/currency.queries.ts">
import { gql } from '@apollo/client';

export const GET_CURRENCIES = gql`
  query GetCurrencies {
    currencies {
      id
      code
      name
      symbol
      decimalPlaces
      isActive
      isBaseCurrency
    }
  }
`;

export const GET_CURRENCY_BY_CODE = gql`
  query GetCurrencyByCode($code: String!) {
    currencyByCode(code: $code) {
      id
      code
      name
      symbol
      decimalPlaces
      isActive
      isBaseCurrency
    }
  }
`;

export const GET_CURRENT_EXCHANGE_RATE = gql`
  query GetCurrentExchangeRate(
    $fromCurrencyCode: String!
    $toCurrencyCode: String!
  ) {
    currentExchangeRate(
      fromCurrencyCode: $fromCurrencyCode
      toCurrencyCode: $toCurrencyCode
    ) {
      id
      rate
      effectiveDate
      fromCurrency {
        code
        symbol
      }
      toCurrency {
        code
        symbol
        decimalPlaces
      }
    }
  }
`;

export const GET_EXCHANGE_RATE_HISTORY = gql`
  query GetExchangeRateHistory(
    $fromCurrencyCode: String!
    $toCurrencyCode: String!
    $limit: Int
  ) {
    exchangeRateHistory(
      fromCurrencyCode: $fromCurrencyCode
      toCurrencyCode: $toCurrencyCode
      limit: $limit
    ) {
      id
      rate
      effectiveDate
      notes
      createdAt
      createdBy {
        name
        email
      }
    }
  }
`;

export const GET_CURRENCY_PREFERENCES = gql`
  query GetCurrencyPreferences {
    currencyPreferences {
      id
      locale
      currency {
        code
        name
        symbol
        decimalPlaces
      }
      isActive
    }
  }
`;

export const GET_CURRENCY_PREFERENCE_BY_LOCALE = gql`
  query GetCurrencyPreferenceByLocale($locale: String!) {
    currencyPreferenceByLocale(locale: $locale) {
      id
      locale
      currency {
        code
        name
        symbol
        decimalPlaces
      }
      isActive
    }
  }
`;
