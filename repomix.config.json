{
  "compress": true,
  "style": "xml",
  "output": ".ai-context/repo-skeleton.xml",
  "repoName": "kickzone-workspace",
  "fileCount": true,
  "tokenCount": true,
  "removeEmptyLines": true,
  "removeComments": true,
  "sort": "path",
  "include": [
    "apps/kickzone-api/src/**/*.ts",
    "apps/client/admins/src/**/*.{ts,tsx}",
    "apps/client/customers/src/**/*.{ts,tsx}",
    "apps/client/sellers/src/**/*.{ts,tsx}",
    "libs/server/entities/src/lib/*.ts",
    "libs/server/modules/src/lib/*.ts",
    "libs/server/resolvers/src/lib/*.ts",
    "libs/server/services/src/lib/*.ts",
    "libs/server/controllers/src/lib/*.ts",
    "libs/server/inputs/src/lib/*.ts",
    "libs/server/guards/src/lib/*.ts",
    "libs/server/strategies/src/lib/*.ts",
    "libs/server/decorators/src/lib/*.ts",
    "libs/server/utils/src/lib/*.ts",
    "libs/shared/graphql-schema/src/lib/schema.gql",
    "libs/shared/codegen/src/lib/generated/graphql.ts",
    "libs/client/shared/graphql/src/lib/**/*.ts",
    "libs/client/shared/hooks/**/*.ts",
    "libs/client/shared/zustand/**/*.ts",
    "libs/client/shared/components/**/*.{ts,tsx}",
    "libs/client/shared/ui/**/*.{ts,tsx}",
    "libs/client/shared/translations/**/*.ts",
    "libs/client/admins/**/*.{ts,tsx}",
    "libs/client/customers/**/*.{ts,tsx}",
    "libs/client/sellers/**/*.{ts,tsx}",
    "libs/shared/product-sizes/src/**/*.ts",
    "libs/shared/shared-i18n/src/**/*.ts",
    "nx.json",
    "tsconfig.base.json",
    "project.json"
  ],
  "ignore": [
    "node_modules/**",
    "dist/**",
    "tmp/**",
    "coverage/**",
    ".nx/cache/**",
    ".nx/workspace-data/**",
    "*.spec.ts",
    "*.spec.tsx",
    "*.test.ts",
    "*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/jest.config.*",
    "**/vite.config.*",
    "**/webpack.config.*",
    "**/nest-webpack.config.*",
    "**/tsconfig.*.json",
    "**/eslint.config.*",
    "**/.babelrc",
    "*.env",
    "*.env.*",
    "*.pem",
    "*.key",
    "uploads/**",
    "migrations.json",
    "docs/**",
    "*.md",
    "*.css",
    "*.html",
    "*.svg",
    "*.png",
    "*.jpg",
    "*.woff",
    "*.woff2",
    "*.ttf",
    "*.eot",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock"
  ],
  "compressOptions": {
    "parser": "typescript",
    "keepExports": true,
    "keepInterfaces": true,
    "keepTypes": true,
    "keepClasses": true,
    "keepDecorators": true,
    "keepFunctionSignatures": true,
    "removeFunctionBodies": true,
    "removeClassMethodBodies": true
  }
}
