{
  "compress": true,
  "repoName": "kickzone-workspace",
  "fileCount": true,
  "tokenCount": {
    "enabled": true
  },
  "removeEmptyLines": true,
  "removeComments": true,
  "sort": "path",
  "include": [
    "libs/shared/graphql-schema/src/lib/schema.gql",
    "libs/server/entities/src/lib/product.entity.ts",
    "libs/server/entities/src/lib/order.entity.ts",
    "libs/server/entities/src/lib/user.entity.ts",
    "libs/server/entities/src/lib/cart.entity.ts",
    "libs/server/entities/src/lib/seller-product.entity.ts",
    "libs/server/entities/src/lib/seller-info.entity.ts",
    "libs/server/entities/src/lib/category.entity.ts",
    "libs/server/entities/src/lib/brand.entity.ts",
    "libs/server/entities/src/lib/color.entity.ts",
    "libs/server/entities/src/lib/product-info.entity.ts",
    "libs/server/entities/src/lib/product-description.entity.ts",
    "libs/server/entities/src/lib/order-item.entity.ts",
    "libs/server/entities/src/lib/cart-item.entity.ts",
    "libs/server/modules/src/lib/*.module.ts",
    "libs/server/inputs/src/lib/product.input.ts",
    "libs/server/inputs/src/lib/order.inputs.ts",
    "libs/server/inputs/src/lib/seller.input.ts",
    "libs/server/inputs/src/lib/user.input.ts",
    "libs/server/inputs/src/lib/brand.input.ts",
    "libs/server/inputs/src/lib/category.input.ts",
    "libs/server/inputs/src/lib/color.input.ts",
    "libs/server/inputs/src/lib/cart.inputs.ts",
    "libs/shared/graphql-schema/src/lib/schema.gql"
  ],
  "ignore": [
    "node_modules/**",
    "dist/**",
    "tmp/**",
    "coverage/**",
    ".nx/cache/**",
    ".nx/workspace-data/**",
    "*.spec.ts",
    "*.spec.tsx",
    "*.test.ts",
    "*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/jest.config.*",
    "**/vite.config.*",
    "**/webpack.config.*",
    "**/nest-webpack.config.*",
    "**/tsconfig.*.json",
    "**/eslint.config.*",
    "**/.babelrc",
    "*.env",
    "*.env.*",
    "*.pem",
    "*.key",
    "uploads/**",
    "migrations.json",
    "docs/**",
    "*.md",
    "*.css",
    "*.html",
    "*.svg",
    "*.png",
    "*.jpg",
    "*.woff",
    "*.woff2",
    "*.ttf",
    "*.eot",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "repomix-output.xml",
    "tsconfig.base.json",
    "libs/server/services/**",
    "libs/server/resolvers/**",
    "libs/server/controllers/**",
    "libs/server/utils/**",
    "libs/server/guards/**",
    "libs/server/strategies/**",
    "libs/server/decorators/**",
    "libs/client/**",
    "apps/client/**",
    "libs/shared/codegen/**",
    "libs/shared/product-sizes/**",
    "libs/shared/shared-i18n/**",
    "libs/server/entities/src/lib/refresh-token.entity.ts",
    "libs/server/entities/src/lib/platform-settings.entity.ts",
    "libs/server/entities/src/lib/currency-preference.entity.ts",
    "libs/server/entities/src/lib/exchange-rate.entity.ts",
    "libs/server/entities/src/lib/site-language.entity.ts",
    "libs/server/entities/src/lib/translation.entity.ts",
    "libs/server/entities/src/lib/customer-profile.entity.ts",
    "libs/server/entities/src/lib/currency.entity.ts",
    "libs/server/entities/src/lib/product-info-color.entity.ts",
    "libs/server/inputs/src/lib/product-info-filter.input.ts",
    "libs/server/inputs/src/lib/order-pagination.inputs.ts",
    "libs/server/inputs/src/lib/seller-order-pagination.inputs.ts",
    "libs/server/inputs/src/lib/site-language.input.ts",
    "libs/server/inputs/src/lib/customer-auth.inputs.ts"
  ],
  "compressOptions": {
    "parser": "typescript",
    "keepExports": true,
    "keepInterfaces": true,
    "keepTypes": true,
    "keepClasses": true,
    "keepDecorators": true,
    "keepFunctionSignatures": true,
    "removeFunctionBodies": true,
    "removeClassMethodBodies": true
  }
}
