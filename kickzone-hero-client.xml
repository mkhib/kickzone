            <Typography variant="h6" sx={{ mb: 2 }}>
              {LL.products.productDetails()}
            </Typography>
            <Paper
              elevation={0}
              sx={{
                mb: 2,
                p: 2,
                display: 'flex',
                flexDirection: 'column',
                gap: 2,
                backgroundColor:
                  theme.palette.mode === 'dark'
                    ? 'rgba(18, 18, 22, 0.88)'
                    : 'rgba(255, 255, 255, 0.96)',
                border:
                  theme.palette.mode === 'dark'
                    ? '1px solid rgba(255, 255, 255, 0.08)'
                    : '1px solid rgba(0, 0, 0, 0.08)',
                borderRadius: '16px',
                boxShadow:
                  theme.palette.mode === 'dark'
                    ? '0 10px 30px rgba(0,0,0,0.4)'
                    : '0 10px 30px rgba(0,0,0,0.12)',
              }}
            >
              <TextField
                id="product-name"
                slotProps={{
                  input: { 'aria-label': 'Product Name' },
                }}
                fullWidth
                label={LL.form.productName()}
                name="name"
                value={product.name}
                onChange={handleProductChange}
                required
              />
              <TextField
                id="product-sku"
                fullWidth
                label={LL.form.sku()}
                name="sku"
                value={product.sku}
                onChange={handleProductChange}
                required
                {...getLtrTextFieldProps()}
                slotProps={{
                  htmlInput: { dir: 'ltr', 'aria-label': 'SKU' },
                }}
              />
              <Box>
                <Autocomplete
                  multiple
                  disableCloseOnSelect
                  openOnFocus
                  clearOnBlur={false}
                  open={categoriesAutocomplete.open}
                  onOpen={categoriesAutocomplete.onOpen}
                  onClose={categoriesAutocomplete.onClose}
                  id="categories-autocomplete"
                  options={categories || []}
                  getOptionLabel={(option) => option.name}
                  value={
                    categories?.filter((cat) =>
                      product.categoryIds.includes(cat.id)
                    ) || []
                  }
                  onChange={(_e, newValue, reason) => {
                    if (
                      reason === 'selectOption' ||
                      reason === 'removeOption'
                    ) {
                      categoriesAutocomplete.markSelection();
                    }
                    setProduct((prev) => ({
                      ...prev,
                      categoryIds: newValue.map((category) => category.id),
                    }));
                  }}
                  loading={getCategoriesLoading}
                  renderInput={(params) => (
                    <TextField
                      {...params}
                      label={LL.form.category()}
                      slotProps={{
                        input: {
                          ...params.InputProps,
                          'aria-label': 'Category',
                        },
                      }}
                    />
                  )}
                  isOptionEqualToValue={(option, value) =>
                    option.id === value.id
                  }
                  filterSelectedOptions
                  slotProps={{
                    listbox: multiSelectListboxSlotProps,
                  }}
                />
                <Button
                  variant="outlined"
                  onClick={() => setIsManageCategoriesModalOpen(true)}
                  sx={{ mt: 1 }}
                  fullWidth={isMobile}
                >
                  {LL.categories.manageCategories()}
                </Button>
              </Box>
              <Box>
                <Autocomplete
                  id="brand-autocomplete"
                  options={brands || []}
                  getOptionLabel={(option) => option.name}
                  value={
                    brands?.find((b) => b.id === product.brandId) || null
                  }
                  onChange={(_e, newValue) => {
                    setProduct((prev) => ({
                      ...prev,
                      brandId: newValue?.id ?? null,
                    }));
                  }}
                  loading={getBrandsLoading}
                  renderInput={(params) => (
                    <TextField
                      {...params}
                      label={LL.form.brand()}
                      slotProps={{
                        input: {
                          ...params.InputProps,
                          'aria-label': 'Brand',
                        },
                      }}
                    />
                  )}
                  isOptionEqualToValue={(option, value) =>
                    option.id === value.id
                  }
                />
              </Box>
              <Box sx={{ mt: 2 }}>
                <Typography
                  variant="subtitle2"
                  sx={{ mb: 1, fontWeight: 600, color: 'text.secondary' }}
                >
                  {LL.form.description()}
                </Typography>
                <Tabs
                  value={activeDescTab}
                  onChange={handleDescTabChange}
                  variant="scrollable"
                  scrollButtons="auto"
                  sx={{ borderBottom: 1, borderColor: 'divider', mb: 1.5 }}
                >
                  {languagesToDisplay.map((lang) => {
                    const hasContent = Boolean(descriptions[lang.code]?.trim());
                    return (
                      <Tab
                        key={lang.code}
                        value={lang.code}
                        label={
                          <Box
                            sx={{
                              display: 'flex',
                              alignItems: 'center',
                              gap: 0.75,
                            }}
                          >
                            <span>
                              {lang.nativeName} ({lang.name})
                            </span>
                            {hasContent && (
                              <Chip
                                size="small"
                                label="✓"
                                color="success"
                                sx={{
                                  height: 18,
                                  fontSize: '0.7rem',
                                  px: 0.25,
                                }}
                              />
                            )}
                          </Box>
                        }
                      />
                    );
                  })}
                </Tabs>

                {languagesToDisplay.map((lang) => {
                  if (activeDescTab !== lang.code) return null;
                  return (
                    <TextField
                      key={lang.code}
                      id={`product-description-${lang.code}`}
                      label={`${LL.form.description()} (${lang.nativeName})`}
                      name={`description-${lang.code}`}
                      value={descriptions[lang.code] || ''}
                      onChange={(e) =>
                        handleDescriptionChange(lang.code, e.target.value)
                      }
                      fullWidth
                      multiline
                      minRows={3}
                      maxRows={8}
                      dir={lang.isRTL ? 'rtl' : 'ltr'}
                      slotProps={{
                        htmlInput: {
                          'data-testid': `product-description-${lang.code}`,
                        },
                      }}
                      placeholder={
                        lang.isRTL
                          ? 'توضیحات محصول را به زبان فارسی وارد کنید...'
                          : 'Enter product description in English...'
                      }
                      helperText={
                        lang.isDefault
                          ? 'زبان پیش‌فرض سایت / Default site language'
                          : undefined
                      }
                    />
                  );
                })}
              </Box>
            </Paper>
          </Grid>
          {/* Right Side - ProductInfos Section */}
          <Grid size={{ xs: 12, md: 6 }}>
            <Typography variant="h6" sx={{ mb: 2 }}>
              {LL.products.productVariants()}
            </Typography>
            {productInfos.map((info, idx) => (
              <ProductInfoCard
                key={idx}
                info={info}
                idx={idx}
                onChange={handleProductInfoChange}
                onColorsChange={(idx, colors: KickzoneGraphqlTypes.Color[]) =>
                  setProductInfos((prev) => {
                    const updated = [...prev];
                    updated[idx] = { ...updated[idx], colors };
                    return updated;
                  })
                }
                availableColors={
                  (availableColors as KickzoneGraphqlTypes.Color[])?.filter(
                    (color): color is KickzoneGraphqlTypes.Color =>
                      color != null
                  ) || []
                }
                onManageColors={
                  idx === 0 ? () => setIsManageColorsModalOpen(true) : undefined
                }
                manageColorsDisabled={colorMutationsLoading}
                onRemove={handleRemoveProductInfo}
                disableRemove={productInfos.length === 1}
                onRemoveImage={(infoIdx: number, imageIdx: number) => {
                  const info = productInfos[infoIdx];
                  // Check if it's a selected image (newImagePreviews) or uploaded image (uploadedImageUrls)
                  if (imageIdx < info.newImagePreviews.length) {
                    // It's a selected image - show confirmation modal
                    setDeleteImageModal({
                      open: true,
                      infoIdx,
                      imageIdx,
                      imageType: 'preview',
                      isLoading: false,
                    });
                  } else {
                    // It's an uploaded image - show confirmation modal
                    const actualImageIdx =
                      imageIdx - info.newImagePreviews.length;
                    setDeleteImageModal({
                      open: true,
                      infoIdx,
                      imageIdx: actualImageIdx,
                      imageType: 'uploaded',
                      isLoading: false,
                    });
                  }
                }}
                onUploadSelectedImages={handleUploadSelectedImages}
                setProductInfos={setProductInfos}
                LL={LL}
              />
            ))}
            <Button
              variant="outlined"
              startIcon={<AddIcon />}
              onClick={handleAddProductInfo}
              sx={{ mt: 2 }}
              disabled={isCreatingProduct}
              fullWidth={isMobile}
            >
              {LL.products.addVariant()}
            </Button>
          </Grid>
          {/* Save Button */}
          <Grid size={12} sx={{ mt: 'auto' }}>
            <Box
              sx={{
                display: 'flex',
                justifyContent: { xs: 'stretch', md: 'flex-end' },
              }}
            >
              <Button
                type="submit"
                variant="contained"
                color="primary"
                sx={{ textTransform: 'none' }}
                loading={isCreatingProduct}
                fullWidth={isMobile}
              >
                {LL.products.saveProduct()}
              </Button>
            </Box>
          </Grid>
        </Grid>
      </form>
    </>
  );

  const modals = (
    <>
      <ManageCategoriesModal
        open={isManageCategoriesModalOpen}
        onClose={() => setIsManageCategoriesModalOpen(false)}
        categories={categories || []}
        onAdd={() => setIsNewCategoryModalOpen(true)}
        onEdit={(category) => {
          setSelectedCategory(category);
          setIsEditCategoryModalOpen(true);
        }}
        onDelete={handleOpenDeleteCategoryModal}
        isLoading={
          isCreatingCategory || isUpdatingCategory || isDeletingCategory
        }
        LL={LL}
      />
      <CategoryModal
        open={isNewCategoryModalOpen}
        onClose={() => setIsNewCategoryModalOpen(false)}
        onSubmit={async (name) => {
          try {
            const slug = slugify(name);
            await createCategory(slug, 0, name);
            setIsNewCategoryModalOpen(false);
            showSnackbar('Category created successfully', {
              severity: 'success',
            });
          } catch (error) {
            const message = (error as Error).message;
            if (message.includes('already exists')) {
              showSnackbar(message, { severity: 'error' });
            } else {
              showSnackbar((error as Error).message, { severity: 'error' });
            }
          }
        }}
        title={LL.categories.addCategory()}
        isLoading={isCreatingCategory}
        LL={LL}
      />
      <CategoryModal
        open={isEditCategoryModalOpen}
        onClose={() => {
          setIsEditCategoryModalOpen(false);
          setSelectedCategory(null);
        }}
        onSubmit={async (name) => {
          try {
            if (selectedCategory) {
              const slug = slugify(name);
              await updateCategory(
                selectedCategory.id,
                slug,
                undefined,
                undefined,
                name
              );
            }
            setIsEditCategoryModalOpen(false);
            setSelectedCategory(null);
            showSnackbar('Category updated successfully', {
              severity: 'success',
            });
          } catch (error) {
            const message = (error as Error).message;
            if (message.includes('already exists')) {
              showSnackbar(message, { severity: 'error' });
            } else {
              showSnackbar((error as Error).message, { severity: 'error' });
            }
          }
        }}
        initialName={selectedCategory?.name || ''}
        title={LL.categories.editCategory()}
        isLoading={isUpdatingCategory}
        LL={LL}
      />
      <DeleteCategoryModal
        open={isDeleteCategoryModalOpen}
        onClose={handleCloseDeleteCategoryModal}
        onConfirm={handleDeleteCategory}
        categoryName={categoryToDelete?.name || ''}
        isLoading={isDeletingCategory}
        LL={LL}
      />
      <DeleteImageModal
        open={deleteImageModal.open}
        onClose={handleCloseDeleteImageModal}
        onConfirm={handleConfirmDeleteImage}
        imageType={
          deleteImageModal.imageType === 'preview' ? 'preview' : 'uploaded'
        }
        isLoading={deleteImageModal.isLoading}
        LL={LL}
      />
      <ManageColorsModal
        open={isManageColorsModalOpen}
        onClose={() => setIsManageColorsModalOpen(false)}
        colors={
          (availableColors as KickzoneGraphqlTypes.Color[])?.filter(
            (color): color is KickzoneGraphqlTypes.Color => color != null
          ) || []
        }
        onAdd={() => {
          setSelectedColor(null);
          setIsNewColorModalOpen(true);
        }}
        onEdit={handleOpenEditColorModal}
        onDelete={handleOpenDeleteColorModal}
        isLoading={colorMutationsLoading}
        LL={LL}
      />
      <ColorModal
        open={isNewColorModalOpen || isEditColorModalOpen}
        onClose={handleCloseColorModal}
        onSubmit={handleSaveColor}
        initialColor={selectedColor}
        title={
          selectedColor
            ? LL.colorManagement.editColor()
            : LL.colorManagement.addNewColor()
        }
        isLoading={colorMutationsLoading}
        LL={LL}
      />
      <DeleteColorModal
        open={isDeleteColorModalOpen}
        onClose={handleCloseDeleteColorModal}
        onConfirm={handleDeleteColor}
        colorName={colorToDelete?.name || ''}
        isLoading={colorMutationsLoading}
        LL={LL}
      />
    </>
  );

  if (embedded) {
    return (
      <>
        {formAndTitle}
        {modals}
      </>
    );
  }

  return (
    <LayoutComponent>
      <GlassmorphismContainer>{formAndTitle}</GlassmorphismContainer>
      {modals}
    </LayoutComponent>
  );
}

