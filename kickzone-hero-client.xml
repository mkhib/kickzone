type LayoutComponentType = React.ComponentType<{ children: React.ReactNode }>;

export type CreatedCatalogProduct = {
  product: { id: number; name: string; sku?: string | null };
  productInfos: Array<{
    id: number;
    size: string;
    sizeKind?: SizeKind;
    weight: number;
    colors?: Array<{
      id: number;
      name: string;
      hexCode: string;
    }> | null;
  }>;
};

export interface AdminProductEditorProps {
  LayoutComponent?: LayoutComponentType;
  /** Render without page chrome so it can be nested in another screen. */
  embedded?: boolean;
  /** After a new catalog product is created, call this instead of resetting the form. */
  onCreated?: (result: CreatedCatalogProduct) => void;
}

export function AdminProductEditor({
  LayoutComponent = AdminsLayout,
  embedded = false,
  onCreated,
}: AdminProductEditorProps = {}) {
  const { LL } = useI18nContext();
  usePageTitle(() =>
    embedded
      ? LL.pageTitles.sellerManageProduct()
      : LL.pageTitles.adminProductEditor()
  );
  const { id } = useParams<{ id?: string }>();
  const productIdNum = id ? Number(id) : undefined;
  const { product: loadedProduct, refetch: refetchProduct } =
    useProductById(productIdNum);
  const { siteLanguages } = useSiteLanguages();

  const languagesToDisplay = React.useMemo(() => {
    if (siteLanguages && siteLanguages.length > 0) {
      return siteLanguages;
    }
    return [
      {
        id: '1',
        code: 'fa',
        name: 'Persian',
        nativeName: 'فارسی',
        isRTL: true,
        isActive: true,
        isDefault: true,
      },
      {
        id: '2',
        code: 'en',
        name: 'English',
        nativeName: 'English',
        isRTL: false,
        isActive: true,
        isDefault: false,
      },
    ];
  }, [siteLanguages]);

  const [activeDescTab, setActiveDescTab] = useState('fa');
  const [descriptions, setDescriptions] = useState<Record<string, string>>({});

  const [product, setProduct] = useState({
    name: '',
    sku: '',
    categoryIds: [] as number[],
    brandId: null as number | null,
    description: '',
  });

  const [productInfos, setProductInfos] = useState<ProductInfoState[]>([
    {
      productId: 0,
      size: '',
      sizeKind: SizeKind.Apparel,
      colors: [],
      weight: 0,
      images: [],
      imagePreviews: [],
      uploadedImageUrls: [],
      createdId: null,
      isUploading: false,
      newImages: [],
      newImagePreviews: [],
    },
  ]);

  const [, setCreatedProductInfoIds] = useState<(number | null)[]>([null]);

  // Shared Zod rules (react-hook-form) for the required product and variant fields.
  const editorValues = useMemo<ProductEditorFormInput>(
    () => ({
      name: product.name,
      sku: product.sku,
      categoryIds: product.categoryIds,
      variants: productInfos.map((info) => ({
        // Pants need both waist and inseam (which ensures the size is set).
        size: isPantsSizeKind(info.sizeKind)
          ? info.waist !== undefined && info.inseam !== undefined
            ? formatPantsSize(info.waist, info.inseam)
            : ''
          : info.size,
        colorIds: info.colors.map((c) => c.id),
        weight: Number(info.weight) || 0,
      })),
    }),
    [product, productInfos]
  );
  const editorForm = useForm<ProductEditorFormInput>({
    values: editorValues,
    resolver: zodResolver(productEditorFormSchema),
    mode: 'onSubmit',
  });

  const [isManageCategoriesModalOpen, setIsManageCategoriesModalOpen] =
    useState(false);
  const [isNewCategoryModalOpen, setIsNewCategoryModalOpen] = useState(false);
  const [isEditCategoryModalOpen, setIsEditCategoryModalOpen] = useState(false);
  const [selectedCategory, setSelectedCategory] = useState<{
    id: number;
    name: string;
  } | null>(null);

  const [isDeleteCategoryModalOpen, setIsDeleteCategoryModalOpen] =
    useState(false);
  const [categoryToDelete, setCategoryToDelete] = useState<{
    id: number;
    name: string;
  } | null>(null);

  const [deleteImageModal, setDeleteImageModal] = useState<{
    open: boolean;
    infoIdx: number | null;
    imageIdx: number | null;
    imageType: 'preview' | 'uploaded' | null;
    isLoading: boolean;
  }>({
    open: false,
    infoIdx: null,
    imageIdx: null,
    imageType: null,
    isLoading: false,
  });

  const [isManageColorsModalOpen, setIsManageColorsModalOpen] = useState(false);
  const [isNewColorModalOpen, setIsNewColorModalOpen] = useState(false);
  const [isEditColorModalOpen, setIsEditColorModalOpen] = useState(false);
  const [selectedColor, setSelectedColor] =
    useState<KickzoneGraphqlTypes.Color | null>(null);

  const [isDeleteColorModalOpen, setIsDeleteColorModalOpen] = useState(false);
  const [colorToDelete, setColorToDelete] = useState<{
    id: number;
    name: string;
  } | null>(null);

  const { categories, getCategoriesLoading } = useCategoriesQuery();
  const { brands, getBrandsLoading } = useBrandsQuery();
  const {
    createCategory,
    updateCategory,
    deleteCategory,
    isCreatingCategory,
    isUpdatingCategory,
    isDeletingCategory,
  } = useCategories();

  const {
    createProductWithInfos,
    uploadProductInfoImages,
    removeProductInfoImage,
    isCreatingProduct,
    updateProduct,
  } = useProducts();
  const { showSnackbar } = useSnackbarContext();

  const theme = useTheme();
  const isMobile = useMediaQuery(theme.breakpoints.down('md'));
  const categoriesAutocomplete = useMultiSelectAutocompleteOpen();

  const {
    colors: availableColors,
    createColor,
    updateColor,
    deleteColor,
    loading: colorMutationsLoading,
  } = useColors();

  const slugify = useCallback(
    (name: string) => name.toLowerCase().trim().replace(/\s+/g, '-'),
    []
  );

  const resetDeleteImageModal = useCallback(() => {
    setDeleteImageModal({
      open: false,
      infoIdx: null,
      imageIdx: null,
      imageType: null,
      isLoading: false,
    });
  }, []);

  // Fetch product if editing
  useEffect(() => {
    if (productIdNum && loadedProduct) {
      const descMap: Record<string, string> = {};
      if (loadedProduct.descriptions && loadedProduct.descriptions.length > 0) {
        loadedProduct.descriptions.forEach((d) => {
          if (d?.language?.code && d?.description) {
            descMap[d.language.code] = d.description;
          }
        });
      } else if (loadedProduct.description) {
        descMap['fa'] = loadedProduct.description;
        descMap['en'] = loadedProduct.description;
      }
      setDescriptions(descMap);

      setProduct({
        name: loadedProduct.name,
        sku: loadedProduct.sku || '',
        categoryIds: loadedProduct.categories.map((cat) => cat.id),
        brandId: loadedProduct.brandId ?? loadedProduct.brand?.id ?? null,
        description: loadedProduct.description || '',
      });
      setProductInfos(
        loadedProduct.productInfos.map((info) => {
          const sizeKind = resolveSizeKind(info.sizeKind);
          const base = {
            productId: loadedProduct.id,
            size: info.size,
            sizeKind,
            colors: info.colors || [],
            weight: info.weight,
            images: [],
            imagePreviews: [],
            uploadedImageUrls: info.images || [],
            createdId: info.id,
            isUploading: false,
            newImages: [],
            newImagePreviews: [],
          };
          // Parse pants composite size for waist/inseam fields
          if (isPantsSizeKind(sizeKind) && info.size) {
            const parsed = parsePantsSize(info.size);
            if (parsed) {
              return { ...base, waist: parsed.waist, inseam: parsed.inseam };
            }
          }
          return base;
        })
      );
      setCreatedProductInfoIds(
        loadedProduct.productInfos.map((info) => info.id)
      );
    }
  }, [
    productIdNum,
    loadedProduct?.id,
    loadedProduct?.name,
    loadedProduct?.sku,
    loadedProduct?.description,
    loadedProduct?.categories,
    loadedProduct?.productInfos,
    loadedProduct,
  ]);

  // Handlers for product fields
  const handleProductChange = useCallback(
    (e: React.ChangeEvent<HTMLInputElement>) => {
      const { name, value } = e.target;
      setProduct((prev) => ({ ...prev, [name]: value }));
    },
    []
  );

  const handleDescriptionChange = useCallback(
    (langCode: string, value: string) => {
      setDescriptions((prev) => ({ ...prev, [langCode]: value }));
    },
    []
  );

  const handleDescTabChange = useCallback(
    (_event: React.SyntheticEvent, newLocale: string) => {
      setActiveDescTab(newLocale);
    },
    []
  );

  // Handlers for product info fields
  const handleProductInfoChange = useCallback(
    (
      index: number,
      name: keyof Omit<
        ProductInfoState,
        | 'colors'
        | 'images'
        | 'imagePreviews'
        | 'uploadedImageUrls'
        | 'createdId'
        | 'isUploading'
        | 'newImages'
        | 'newImagePreviews'
      >,
      value: unknown
    ) => {
      setProductInfos((prev) => {
        const updated = [...prev];
        updated[index] = { ...updated[index], [name]: value };
        return updated;
      });
    },
    []
  );

  // Add a new ProductInfo variant
  const handleAddProductInfo = useCallback(() => {
    setProductInfos((prev) => [
      ...prev,
      {
        productId: 0,
        size: '',
        sizeKind: SizeKind.Apparel,
        waist: undefined,
        inseam: undefined,
        colors: [],
        weight: 0,
        images: [],
        imagePreviews: [],
        uploadedImageUrls: [],
        createdId: null,
        isUploading: false,
        newImages: [],
        newImagePreviews: [],
      } as ProductInfoState,
    ]);
    setCreatedProductInfoIds((prev) => [...prev, null]);
  }, []);

  // Remove a ProductInfo variant
  const handleRemoveProductInfo = useCallback((index: number) => {
    setProductInfos((prev) => prev.filter((_, i) => i !== index));
    setCreatedProductInfoIds((prev) => prev.filter((_, i) => i !== index));
  }, []);

  // Handle product creation
  const handleSubmit = useCallback(
    async (e: React.FormEvent) => {
      e.preventDefault();
      try {
        // Validate required fields
        if (!(await editorForm.trigger(['name', 'sku', 'categoryIds']))) {
          showSnackbar('Please fill in all required fields', {
            severity: 'error',
          });
          return;
        }
        if (!(await editorForm.trigger('variants'))) {
          showSnackbar('Please fill in all product variant fields', {
            severity: 'error',
          });
          return;
        }
        const descriptionList = languagesToDisplay
          .map((lang) => ({
            languageId: Number(lang.id),
            languageCode: lang.code,
            description: descriptions[lang.code]?.trim() || '',
          }))
          .filter((d) => d.description !== '');

        const primaryDesc =
          descriptions[activeDescTab]?.trim() ||
          descriptions['fa']?.trim() ||
          descriptions['en']?.trim() ||
          Object.values(descriptions).find((v) => v?.trim())?.trim() ||
          (product.description === '' ? null : product.description);

        if (productIdNum) {
          // Editing existing product
          const variantsPayload: KickzoneGraphqlTypes.ProductVariantInput[] =
            productInfos.map((info) => ({
              id: info.createdId || undefined,
              size:
                isPantsSizeKind(info.sizeKind) &&
                info.waist != null &&
                info.inseam != null
                  ? formatPantsSize(info.waist, info.inseam)
                  : info.size,
              sizeKind: toGraphQLSizeKind(info.sizeKind),
              colorIds: info.colors.map((c) => c.id),
              weight: Number(info.weight),
              images:
                info.uploadedImageUrls && info.uploadedImageUrls.length > 0
                  ? info.uploadedImageUrls
                  : undefined,
            }));

          const updated = await updateProduct({
            id: productIdNum,
            name: product.name,
            sku: product.sku.trim(),
            categoryIds: product.categoryIds,
            brandId: product.brandId,
            description: primaryDesc,
            descriptions: descriptionList,
            variants: variantsPayload,
          });

          // Upload new images for any variants
          if (updated?.productInfos) {
            for (let i = 0; i < productInfos.length; i++) {
              const info = productInfos[i];
              const serverInfo = updated.productInfos[i];
              const variantId = serverInfo?.id || info.createdId;
              if (variantId && info.newImages && info.newImages.length > 0) {
                try {
                  await uploadProductInfoImages(variantId, info.newImages);
                } catch (imgErr) {
                  console.error('Failed to upload variant images:', imgErr);
                }
              }
            }
          }

          // Invalidate and refetch product query to ensure synchronized state
          await refetchProduct?.();

          // Sync state with server response
          if (updated?.productInfos) {
            setCreatedProductInfoIds(updated.productInfos.map((pi) => pi.id));
            setProductInfos((prev) =>
              prev.map((info, i) => {
                const serverInfo = updated.productInfos[i];
                return {
                  ...info,
                  createdId: serverInfo?.id ?? info.createdId,
                  uploadedImageUrls:
                    serverInfo?.images ?? info.uploadedImageUrls,
                  newImages: [],
                  newImagePreviews: [],
                };
              })
            );
          }

          showSnackbar('Product updated successfully', { severity: 'success' });
        } else {
          // Create product and all product infos
          const created = await createProductWithInfos(
            {
              name: product.name,
              sku: product.sku.trim(),
              categoryIds: product.categoryIds,
              brandId: product.brandId,
              description: primaryDesc,
              descriptions:
                descriptionList.length > 0 ? descriptionList : undefined,
            },
            productInfos.map((info) => ({
              size:
                isPantsSizeKind(info.sizeKind) &&
                info.waist != null &&
                info.inseam != null
                  ? formatPantsSize(info.waist, info.inseam)
                  : info.size,
              sizeKind: toGraphQLSizeKind(info.sizeKind),
              colorIds: info.colors.map((c) => c.id),
              weight: Number(info.weight),
            }))
          );
          setCreatedProductInfoIds(created.productInfos.map((pi) => pi.id));
          setProductInfos((prev) =>
            prev.map((info, i) => ({
              ...info,
              createdId: created.productInfos[i]?.id || null,
            }))
          );
          showSnackbar('Product created successfully', { severity: 'success' });
          if (onCreated) {
            onCreated({
              product: created.product,
              productInfos: created.productInfos.map((pi) => ({
                ...pi,
                sizeKind: fromGraphQLSizeKind(pi.sizeKind),
              })),
            });
            return;
          }
          // Reset form to initial state
          setDescriptions({});
          setProduct({
            name: '',
            sku: '',
            categoryIds: [],
            brandId: null,
            description: '',
          });
          setProductInfos([
            {
              productId: 0,
              size: '',
              sizeKind: SizeKind.Apparel,
              colors: [],
              weight: 0,
              images: [],
              imagePreviews: [],
              uploadedImageUrls: [],
              createdId: null,
              isUploading: false,
              newImages: [],
              newImagePreviews: [],
            },
          ]);
          setCreatedProductInfoIds([null]);
        }
      } catch (error) {
        const message = (error as Error).message;
        if (message.includes('already exists')) {
          showSnackbar(message, { severity: 'error' });
        } else {
          showSnackbar((error as Error).message, { severity: 'error' });
        }
      }
    },
    [
      editorForm,
      product,
      productInfos,
      createProductWithInfos,
      updateProduct,
      uploadProductInfoImages,
      refetchProduct,
      showSnackbar,
      productIdNum,
      onCreated,
      languagesToDisplay,
      descriptions,
      activeDescTab,
    ]
  );

  const handleDeleteCategory = useCallback(async () => {
    if (!categoryToDelete) return;
    try {
      await deleteCategory(categoryToDelete.id);
      setIsDeleteCategoryModalOpen(false);
      setCategoryToDelete(null);
      showSnackbar('Category deleted successfully', { severity: 'success' });
    } catch (error) {
      const message = (error as Error).message;
      showSnackbar(message, { severity: 'error' });
    }
  }, [categoryToDelete, deleteCategory, showSnackbar]);

  const handleOpenDeleteCategoryModal = useCallback(
    (category: { id: number; name: string }) => {
      setCategoryToDelete(category);
      setIsDeleteCategoryModalOpen(true);
    },
    []
  );

  const handleCloseDeleteCategoryModal = useCallback(() => {
    setIsDeleteCategoryModalOpen(false);
    setCategoryToDelete(null);
  }, []);

  const handleRemoveSelectedImage = useCallback(
    (infoIdx: number, imageIdx: number) => {
      setProductInfos((prev) => {
        const updated = [...prev];
        updated[infoIdx].newImages.splice(imageIdx, 1);
        updated[infoIdx].newImagePreviews.splice(imageIdx, 1);
        return updated;
      });
    },
    []
  );

  const handleConfirmDeleteImage = useCallback(async () => {
    if (
      deleteImageModal.infoIdx === null ||
      deleteImageModal.imageIdx === null ||
      !deleteImageModal.imageType
    ) {
      resetDeleteImageModal();
      return;
    }

    // Set loading state
    setDeleteImageModal((prev) => ({ ...prev, isLoading: true }));

    const { infoIdx, imageIdx, imageType } = deleteImageModal;

    if (imageType === 'preview') {
      // Remove selected image (not yet uploaded)
      handleRemoveSelectedImage(infoIdx, imageIdx);
      setDeleteImageModal({
        open: false,
        infoIdx: null,
        imageIdx: null,
        imageType: null,
        isLoading: false,
      });
    } else if (imageType === 'uploaded') {
      // Remove uploaded image from server
      const info = productInfos[infoIdx];
      if (!info.createdId || !info.uploadedImageUrls[imageIdx]) {
        resetDeleteImageModal();
        return;
      }

      const imageUrl = info.uploadedImageUrls[imageIdx];
      const imageName = imageUrl.split('/').pop();
      if (!imageName) {
        resetDeleteImageModal();
        return;
      }

      try {
        await removeProductInfoImage(info.createdId, imageName);

        // Update local state immediately
        setProductInfos((prev) => {
          const updated = [...prev];
          updated[infoIdx].uploadedImageUrls.splice(imageIdx, 1);
          return updated;
        });

        showSnackbar('Image removed successfully', { severity: 'success' });
      } catch (error) {
        showSnackbar((error as Error).message, { severity: 'error' });
      } finally {
        resetDeleteImageModal();
      }
    }
  }, [
    deleteImageModal,
    handleRemoveSelectedImage,
    removeProductInfoImage,
    productInfos,
    showSnackbar,
    resetDeleteImageModal,
  ]);

  const handleCloseDeleteImageModal = useCallback(() => {
    resetDeleteImageModal();
  }, [resetDeleteImageModal]);

  const handleOpenEditColorModal = useCallback(
    (color: KickzoneGraphqlTypes.Color) => {
      setSelectedColor(color);
      setIsEditColorModalOpen(true);
    },
    []
  );

  const handleCloseColorModal = useCallback(() => {
    setIsNewColorModalOpen(false);
    setIsEditColorModalOpen(false);
    setSelectedColor(null);
  }, []);

  const handleSaveColor = useCallback(
    async (id: number | null, name: string, hexCode: string) => {
      try {
        if (id) {
          await updateColor(id, name, hexCode);
          showSnackbar('Color updated successfully', { severity: 'success' });
        } else {
          await createColor(name, hexCode);
          showSnackbar('Color created successfully', { severity: 'success' });
        }
        handleCloseColorModal();
      } catch (error) {
        showSnackbar((error as Error).message, { severity: 'error' });
      }
    },
    [createColor, updateColor, showSnackbar, handleCloseColorModal]
  );

  const handleDeleteColor = useCallback(async () => {
    if (!colorToDelete) return;
    try {
      await deleteColor(colorToDelete.id);
      setIsDeleteColorModalOpen(false);
      setColorToDelete(null);
      showSnackbar('Color deleted successfully', { severity: 'success' });
    } catch (error) {
      showSnackbar((error as Error).message, { severity: 'error' });
    }
  }, [colorToDelete, deleteColor, showSnackbar]);

  const handleOpenDeleteColorModal = useCallback(
    (color: { id: number; name: string }) => {
      setColorToDelete(color);
      setIsDeleteColorModalOpen(true);
    },
    []
  );

  const handleCloseDeleteColorModal = useCallback(() => {
    setIsDeleteColorModalOpen(false);
    setColorToDelete(null);
  }, []);

  const handleUploadSelectedImages = useCallback(
    async (infoIdx: number) => {
      const info = productInfos[infoIdx];

      if (!info.newImages.length || !info.createdId) {
        return;
      }

      setProductInfos((prev) => {
        const updated = [...prev];
        updated[infoIdx].isUploading = true;
        return updated;
      });

      try {
        const uploadedImages = await uploadProductInfoImages(
          info.createdId,
          info.newImages
        );

        // Update local state immediately with the uploaded images
        setProductInfos((prev) => {
          const updated = [...prev];
          updated[infoIdx].newImages = [];
          updated[infoIdx].newImagePreviews = [];
          updated[infoIdx].isUploading = false;
          // Add the newly uploaded images to the uploadedImageUrls array
          if (uploadedImages && uploadedImages.length > 0) {
            updated[infoIdx].uploadedImageUrls = [
              ...updated[infoIdx].uploadedImageUrls,
              ...uploadedImages,
            ];
          }
          return updated;
        });

        showSnackbar('Images uploaded successfully', { severity: 'success' });
      } catch (error) {
        setProductInfos((prev) => {
          const updated = [...prev];
          updated[infoIdx].isUploading = false;
          return updated;
        });
        showSnackbar((error as Error).message, { severity: 'error' });
      }
    },
    [productInfos, uploadProductInfoImages, showSnackbar]
  );

  const formAndTitle = (
    <>
      {!embedded && (
        <Typography
          variant="h5"
          sx={{ mb: 3, color: theme.palette.text.primary }}
