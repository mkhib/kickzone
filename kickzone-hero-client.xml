          {productIdNum ? LL.products.editProduct() : LL.products.addProduct()}
        </Typography>
      )}
      <form aria-label="Product Editor Form" onSubmit={handleSubmit}>
        <Grid container spacing={3} sx={{ height: '100%' }}>
          {/* Left Side - Basic Product Info */}
