                    </Typography>
                  </Box>
                )}
              </Box>
            );
          })}
        </Box>

        {/* Sticky Panel */}
        <Box
          className="rv"
          sx={{
            position: { xs: 'static', md: 'sticky' },
            top: { md: '88px' },
            background: 'var(--paper)',
            borderRadius: '28px',
            p: { xs: '24px', sm: '32px' },
            boxShadow:
              '0 0 0 1px var(--hair), 0 30px 60px -40px rgba(0,0,0,0.3)',
