// Base state without waist/inseam (for type safety)
interface ProductInfoStateBase {
  productId: number;
  size: string;
  sizeKind: SizeKind;
  colors: KickzoneGraphqlTypes.Color[];
  weight: number;
  images: File[];
  imagePreviews: string[];
  uploadedImageUrls: string[];
  createdId: number | null;
  isUploading: boolean;
  newImages: File[];
  newImagePreviews: { file: File; url: string }[];
}

// Extended state for pants sizing (waist + inseam) - UI only, not sent to backend
export type ProductInfoState = ProductInfoStateBase & {
  waist?: number;
  inseam?: number;
};

interface ProductInfoCardProps {
  info: ProductInfoState;
  idx: number;
  onChange: (
    idx: number,
    name: keyof Omit<
      ProductInfoState,
      | 'colors'
      | 'images'
      | 'imagePreviews'
      | 'uploadedImageUrls'
      | 'createdId'
      | 'isUploading'
      | 'newImages'
      | 'newImagePreviews'
    >,
    value: unknown
  ) => void;
  onColorsChange: (idx: number, colors: KickzoneGraphqlTypes.Color[]) => void;
  availableColors: KickzoneGraphqlTypes.Color[];
  onRemove: (idx: number) => void;
  onRemoveImage: (infoIdx: number, imageIdx: number) => void;
  disableRemove: boolean;
  onUploadSelectedImages: (infoIdx: number) => void;
  setProductInfos: React.Dispatch<React.SetStateAction<ProductInfoState[]>>;
  onManageColors?: () => void;
  manageColorsDisabled?: boolean;
}

const ProductInfoCard = React.memo(
  ({
    info,
    idx,
    onChange,
    onColorsChange,
    availableColors,
    onRemove,
    onRemoveImage,
    disableRemove,
    onUploadSelectedImages,
    setProductInfos,
    onManageColors,
    manageColorsDisabled = false,
    LL,
  }: ProductInfoCardProps & {
    LL: ReturnType<typeof useI18nContext>['LL'];
  }) => {
    // Only allow image selection when editing (product info is already created)
    const isSelectImagesDisabled = info.isUploading || !info.createdId;
    const theme = useTheme();
    const isMobile = useMediaQuery(theme.breakpoints.down('md'));
    const colorsAutocomplete = useMultiSelectAutocompleteOpen();
    const uploadButton = (
      <Button
        component="label"
        variant="contained"
        startIcon={<AddPhotoAlternateIcon />}
        disabled={isSelectImagesDisabled}
      >
        {info.isUploading ? LL.status.uploading() : LL.products.selectImages()}
        <VisuallyHiddenInput
          type="file"
          multiple
          accept="image/*"
          onChange={(e) => {
            const files = Array.from(e.target.files || []);
            if (files.length > 0) {
              // Create preview URLs for selected files
              const newImagePreviews = files.map((file) => ({
                file,
                url: URL.createObjectURL(file),
              }));

              // Update the product info state with new images
              setProductInfos((prev) => {
                const updated = [...prev];
                updated[idx].newImages = [...updated[idx].newImages, ...files];
                updated[idx].newImagePreviews = [
                  ...updated[idx].newImagePreviews,
                  ...newImagePreviews,
                ];
                return updated;
              });
            }
            // Reset the value so the same file can be selected again
            e.target.value = '';
          }}
          disabled={isSelectImagesDisabled}
        />
      </Button>
    );
    return (
      <Paper
        elevation={0}
        sx={{
          mb: 2,
          p: 2,
          position: 'relative',
          backgroundColor:
            theme.palette.mode === 'dark'
              ? 'rgba(18, 18, 22, 0.88)'
              : 'rgba(255, 255, 255, 0.96)',
          border:
            theme.palette.mode === 'dark'
              ? '1px solid rgba(255, 255, 255, 0.08)'
              : '1px solid rgba(0, 0, 0, 0.08)',
          borderRadius: '16px',
          boxShadow:
            theme.palette.mode === 'dark'
              ? '0 10px 30px rgba(0,0,0,0.4)'
              : '0 10px 30px rgba(0,0,0,0.12)',
        }}
      >
        <Box
          sx={{
            display: 'flex',
            flexDirection: { xs: 'column', md: 'row' },
            gap: 2,
            flexWrap: { xs: 'nowrap', md: 'wrap' },
          }}
        >
          <Box
            sx={{
              minWidth: 180,
              width: '100%',
              flex: { md: 1 },
              mb: { xs: 2, md: 0 },
            }}
          >
            <Autocomplete
              multiple
              disableCloseOnSelect
              openOnFocus
              clearOnBlur={false}
              open={colorsAutocomplete.open}
              onOpen={colorsAutocomplete.onOpen}
              onClose={colorsAutocomplete.onClose}
              options={availableColors}
              getOptionLabel={(option) => option.name}
              isOptionEqualToValue={(option, value) => option.id === value.id}
              value={info.colors}
              onChange={(_e, newValue, reason) => {
                if (reason === 'selectOption' || reason === 'removeOption') {
                  colorsAutocomplete.markSelection();
                }
                onColorsChange(idx, newValue);
              }}
              filterSelectedOptions
              slotProps={{
                listbox: multiSelectListboxSlotProps,
              }}
              renderOption={(props, option) => {
                const { key, ...otherProps } = props;
                return (
                  <li key={key} {...otherProps}>
                    <Box
                      sx={{
                        display: 'flex',
                        alignItems: 'center',
                        gap: 1,
                      }}
                    >
                      <Box
                        sx={{
                          width: 16,
                          height: 16,
                          borderRadius: '50%',
                          backgroundColor: option.hexCode,
                          border: '1px solid rgba(0,0,0,0.2)',
                          flexShrink: 0,
                        }}
                      />
                      {option.name}
                    </Box>
                  </li>
                );
              }}
              renderInput={(params) => (
                <TextField
                  {...params}
                  label={LL.form.color()}
                  required
                  slotProps={{
                    htmlInput: {
                      ...params.inputProps,
                      required: info.colors.length === 0,
                    },
                  }}
                />
              )}
              sx={{ width: '100%' }}
            />
            {onManageColors ? (
              <Button
                variant="outlined"
                onClick={onManageColors}
                disabled={manageColorsDisabled}
                sx={{ mt: 1 }}
                fullWidth={isMobile}
              >
                {LL.colorManagement.manageColors()}
              </Button>
            ) : null}
          </Box>
          <FormControl
            required
            sx={{
              flex: 1,
              minWidth: 120,
              width: isMobile ? '100%' : undefined,
            }}
          >
            <InputLabel id={`size-kind-${idx}`}>
              {LL.products.sizeKind()}
            </InputLabel>
            <Select
              labelId={`size-kind-${idx}`}
              label={LL.products.sizeKind()}
              value={info.sizeKind}
              onChange={(e: SelectChangeEvent) => {
                const nextKind = resolveSizeKind(e.target.value);
                onChange(idx, 'sizeKind', nextKind);
                onChange(idx, 'size', '');
                onChange(idx, 'waist', undefined);
                onChange(idx, 'inseam', undefined);
              }}
            >
              <MenuItem value={SizeKind.Apparel}>
                {LL.products.sizeKindApparel()}
              </MenuItem>
              <MenuItem value={SizeKind.Footwear}>
                {LL.products.sizeKindFootwear()}
              </MenuItem>
              <MenuItem value={SizeKind.Pants}>
                {LL.products.sizeKindPants()}
              </MenuItem>
            </Select>
          </FormControl>
          {isPantsSizeKind(info.sizeKind) ? (
            // Pants: standalone waist/inseam fields (avoid nesting under Size FormControl label)
            <Box
              sx={{
                display: 'flex',
                gap: { xs: 1, sm: 2 },
                flex: 1,
                minWidth: { xs: '100%', sm: 280 },
                width: isMobile ? '100%' : undefined,
                flexWrap: { xs: 'wrap', sm: 'nowrap' },
              }}
            >
              <TextField
                name="waist"
                type="number"
                required
                label={LL.products.waist?.() || 'Waist'}
                value={info.waist ?? ''}
                onChange={(e) => {
                  const waist =
                    e.target.value === '' ? undefined : Number(e.target.value);
                  onChange(idx, 'waist', waist);
                  if (waist !== undefined && info.inseam !== undefined) {
                    onChange(idx, 'size', formatPantsSize(waist, info.inseam));
                  } else {
                    onChange(idx, 'size', '');
                  }
                }}
                placeholder={LL.products.waistPlaceholder?.() || '32'}
                inputProps={{ min: 1, max: 99, step: 1 }}
                {...getLtrTextFieldProps({
                  flex: 1,
                  minWidth: { xs: '100%', sm: 130 },
                  sx: {
                    '& .MuiInputLabel-root': {
                      whiteSpace: 'nowrap',
                    },
                  },
                })}
              />
              <TextField
                name="inseam"
                type="number"
                required
                label={LL.products.inseam?.() || 'Inseam'}
                value={info.inseam ?? ''}
                onChange={(e) => {
                  const inseam =
                    e.target.value === '' ? undefined : Number(e.target.value);
                  onChange(idx, 'inseam', inseam);
                  if (inseam !== undefined && info.waist !== undefined) {
                    onChange(idx, 'size', formatPantsSize(info.waist, inseam));
                  } else {
                    onChange(idx, 'size', '');
                  }
                }}
                placeholder={LL.products.inseamPlaceholder?.() || '34'}
                inputProps={{ min: 1, max: 99, step: 1 }}
                {...getLtrTextFieldProps({
                  flex: 1,
                  minWidth: { xs: '100%', sm: 130 },
                  sx: {
                    '& .MuiInputLabel-root': {
                      whiteSpace: 'nowrap',
                    },
                  },
                })}
              />
              {/* Hidden composite size for form/tests — synced from waist/inseam */}
              <input
                type="hidden"
                name="size"
                value={info.size}
                data-testid="hidden-size-input"
              />
            </Box>
          ) : (
            <FormControl
              required
              sx={{
                flex: 1,
                minWidth: 120,
                width: isMobile ? '100%' : undefined,
              }}
            >
              <InputLabel id={`size-value-${idx}`}>
                {LL.products.size()}
              </InputLabel>
              <Select
                labelId={`size-value-${idx}`}
                label={LL.products.size()}
                value={info.size}
                onChange={(e: SelectChangeEvent) =>
                  onChange(idx, 'size', e.target.value)
                }
              >
                {/* Keeps empty value valid without showing a closed-select placeholder */}
                <MenuItem value="" sx={{ display: 'none' }} />
                {(isFootwearSizeKind(info.sizeKind)
                  ? FOOTWEAR_EU_SIZES
                  : APPAREL_SIZES
                ).map((code) => (
                  <MenuItem key={code} value={code}>
                    {isFootwearSizeKind(info.sizeKind)
                      ? `EU ${code}${
                          euToUs(code) ? ` (US ${euToUs(code)})` : ''
                        }`
                      : code}
                  </MenuItem>
                ))}
              </Select>
            </FormControl>
          )}
          <TextField
            label={LL.products.weight()}
            name="weight"
            type="number"
            value={info.weight}
            onChange={(
              e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement>
            ) => onChange(idx, 'weight', e.target.value)}
            required
            {...getLtrTextFieldProps({
              flex: 1,
              minWidth: 100,
              width: isMobile ? '100%' : undefined,
            })}
          />
        </Box>
        <Box sx={{ mt: 2, display: 'flex', alignItems: 'center', gap: 2 }}>
          {info.createdId && uploadButton}
          <IconButton
            onClick={() => onRemove(idx)}
            color="error"
            aria-label="Remove variant"
            sx={{ ml: 1 }}
            disabled={disableRemove}
          >
            <DeleteIcon />
          </IconButton>
        </Box>
        <ImagePreviewContainer>
          {/* Selected (not yet uploaded) images */}
          {info.newImagePreviews.length > 0 && (
            <Box sx={{ width: '100%' }}>
              <Typography
                variant="subtitle2"
                color="text.secondary"
                sx={{ mb: 1 }}
              >
                {LL.products.selectedImagesNotUploaded()}
              </Typography>
              <Box sx={{ display: 'flex', flexWrap: 'wrap', gap: 2 }}>
                {info.newImagePreviews.map((previewObj, imageIdx) => (
                  <ImagePreviewCard key={imageIdx}>
                    <CardMedia
                      component="img"
                      height="140"
                      image={previewObj.url}
                      alt={`Selected image ${imageIdx + 1}`}
                    />
                    <CardActions>
                      <IconButton
                        size="small"
                        onClick={() => onRemoveImage(idx, imageIdx)}
                        sx={{ color: 'error.main' }}
                        aria-label="Delete selected image"
                      >
                        <DeleteIcon />
                      </IconButton>
                    </CardActions>
                  </ImagePreviewCard>
                ))}
              </Box>
              <Button
                variant="contained"
                color="primary"
                sx={{ mt: 1 }}
                onClick={() => {
                  onUploadSelectedImages(idx);
                }}
                disabled={
                  info.isUploading ||
                  info.newImages.length === 0 ||
                  !info.createdId
                }
              >
                {info.isUploading
                  ? LL.status.uploading()
                  : LL.products.uploadImages()}
              </Button>
            </Box>
          )}
          {/* Uploaded images from server */}
          {info.uploadedImageUrls.length > 0 && (
            <Box sx={{ width: '100%', mt: 2 }}>
              <Typography
                variant="subtitle2"
                color="text.secondary"
                sx={{ mb: 1 }}
              >
                {LL.products.uploadedImages()}
              </Typography>
              <Box sx={{ display: 'flex', flexWrap: 'wrap', gap: 2 }}>
                {info.uploadedImageUrls.map(
                  (preview: string, imageIdx: number) => (
                    <ImagePreviewCard key={imageIdx}>
                      <CardMedia
                        component="img"
                        height="140"
                        image={resolveProductImageUrl(preview)}
                        alt={`Product variant image ${imageIdx + 1}`}
                      />
                      <CardActions>
                        <IconButton
                          size="small"
                          onClick={() =>
                            onRemoveImage(
                              idx,
                              info.newImagePreviews.length + imageIdx
                            )
                          }
                          sx={{ color: 'error.main' }}
                          aria-label="Delete uploaded image"
                        >
                          <DeleteIcon />
                        </IconButton>
                      </CardActions>
                    </ImagePreviewCard>
                  )
                )}
              </Box>
            </Box>
          )}
        </ImagePreviewContainer>
      </Paper>
    );
  }
);

interface ColorModalProps {
  open: boolean;
  onClose: () => void;
  onSubmit: (id: number | null, name: string, hexCode: string) => void;
  initialColor?: KickzoneGraphqlTypes.Color | null;
  title: string;
  isLoading?: boolean;
  LL: ReturnType<typeof useI18nContext>['LL'];
}

const ColorModal = ({
  open,
  onClose,
  onSubmit,
  initialColor = null,
  title,
  isLoading = false,
  LL,
}: ColorModalProps) => {
  const [colorName, setColorName] = useState(initialColor?.name || '');
  const [hexCode, setHexCode] = useState(initialColor?.hexCode || '#ffffff');

  useEffect(() => {
    setColorName(initialColor?.name || '');
    setHexCode(initialColor?.hexCode || '#ffffff');
  }, [initialColor]);

  const colorForm = useForm<ColorFormInput>({
    values: { name: colorName, hexCode },
    resolver: zodResolver(colorFormSchema),
    mode: 'onSubmit',
  });
  const colorErrors = colorForm.formState.errors;

  const handleSubmit = useCallback(async () => {
    if (!(await colorForm.trigger())) return;
    onSubmit(initialColor?.id || null, colorName, hexCode);
    // Reset fields for new colors (when initialColor is null)
    if (!initialColor) {
      setColorName('');
      setHexCode('#ffffff');
    }
    onClose();
  }, [colorForm, initialColor, colorName, hexCode, onSubmit, onClose]);

  return (
    <Dialog open={open} onClose={onClose} maxWidth="sm" fullWidth>
      <DialogTitle>{title}</DialogTitle>
      <DialogFormContent>
        <TextField
          autoFocus
          margin="dense"
          label={LL.colorManagement.colorName()}
          fullWidth
          value={colorName}
          onChange={(e) => setColorName(e.target.value)}
          error={Boolean(colorErrors.name)}
        />
        <TextField
          margin="dense"
          label={LL.colorManagement.hexCode()}
          fullWidth
          value={hexCode}
          onChange={(e) => setHexCode(e.target.value)}
          error={Boolean(colorErrors.hexCode)}
          {...getLtrTextFieldProps()}
        />
        <Box sx={{ display: 'flex', justifyContent: 'center' }}>
          <SketchPicker
            color={hexCode}
            onChangeComplete={(color: ColorResult) => setHexCode(color.hex)}
          />
        </Box>
      </DialogFormContent>
      <DialogActions>
        <Button onClick={onClose} disabled={isLoading}>
          {LL.button.cancel()}
        </Button>
        <Button
          onClick={handleSubmit}
          disabled={isLoading}
          loading={isLoading}
          variant="contained"
          color="primary"
        >
          {LL.button.save()}
        </Button>
      </DialogActions>
    </Dialog>
  );
};

