          media: query,
          onchange: null,
          addListener: (cb: (e: MediaQueryListEvent) => void) =>
            listeners.add(cb),
          removeListener: (cb: (e: MediaQueryListEvent) => void) =>
            listeners.delete(cb),
          addEventListener: (
            _type: string,
            cb: (e: MediaQueryListEvent) => void
          ) => listeners.add(cb),
          removeEventListener: (
            _type: string,
            cb: (e: MediaQueryListEvent) => void
          ) => listeners.delete(cb),
          dispatchEvent: vi.fn(),
        };
      }),
    });
  });

  it('shows Lottie loading animation and hides hero and other sections when site is not loaded', () => {
    const { unmount } = render(
      <MemoryRouter initialEntries={['/']}>
        <CustomersHome mockLoading={true} />
      </MemoryRouter>
    );

    // Beautiful loading screen must be present
    expect(screen.getByTestId('home-loading-screen')).toBeInTheDocument();
    expect(screen.getByTestId('lottie-loading')).toBeInTheDocument();
    expect(screen.getByText('در حال آماده‌سازی کلکسیون...')).toBeInTheDocument();

    // Body scroll must be locked
    expect(document.body.style.overflow).toBe('hidden');

    // Hero section and page content MUST NOT be rendered
    expect(screen.queryByText('Rise Above')).not.toBeInTheDocument();
    expect(screen.queryByText('دسته‌بندی‌ها')).not.toBeInTheDocument();
    expect(screen.queryByText('انتخاب‌های SAINTBALA')).not.toBeInTheDocument();

    // Cleanup restores body overflow
    unmount();
    expect(document.body.style.overflow).toBe('');
  });

  it('renders all primary sections of the Campaign v4 design when loaded', () => {
    render(
      <MemoryRouter initialEntries={['/']}>
        <CustomersHome initialData={mockHomePageData} />
      </MemoryRouter>
    );

    expect(screen.queryByTestId('home-loading-screen')).not.toBeInTheDocument();
    expect(screen.getByText('Rise Above')).toBeInTheDocument();
    expect(screen.getByText('۱۰۰٪ اورجینال')).toBeInTheDocument();
    expect(screen.queryByText('ضمانت تعویض ۷ روزه')).not.toBeInTheDocument();
    expect(
      screen.getAllByText('پرداخت آنلاین با زرین‌پال').length
    ).toBeGreaterThanOrEqual(1);

    expect(screen.getByText('دسته‌بندی‌ها')).toBeInTheDocument();
    expect(screen.queryByText('جردن قرمز')).not.toBeInTheDocument();
    expect(screen.getByText('انتخاب‌های SAINTBALA')).toBeInTheDocument();
    expect(screen.getByText('پرداخت امن')).toBeInTheDocument();
  });

  it('strictly contains no forbidden claims or terms', () => {
    const { container } = render(
      <MemoryRouter initialEntries={['/']}>
        <CustomersHome initialData={mockHomePageData} />
      </MemoryRouter>
    );

    const forbiddenWords = [
      'ارسال رایگان',
      'تحویل',
      'پرفروش',
      'تخفیف',
      'کفش',
      'ست‌ها',
      'ضمانت تعویض ۷ روزه',
      'سه نام، یک قول',
    ];
    const pageText = container.textContent || '';

    forbiddenWords.forEach((word) => {
      expect(pageText).not.toContain(word);
    });
  });

  it('filters new arrivals when tabs are clicked', async () => {
    const pageData = selectHomePageData(mockHomePageData);
    render(
      <MemoryRouter initialEntries={['/']}>
        <NewArrivalsSection
          products={pageData.newArrivals}
          exchangeRate={pageData.exchangeRate}
        />
      </MemoryRouter>
    );

    const allTab = screen.getByRole('tab', { name: 'همه' });
    const womenTab = screen.getByRole('tab', { name: 'زنانه' });
    const menTab = screen.getByRole('tab', { name: 'مردانه' });

    expect(allTab).toHaveAttribute('aria-selected', 'true');

    fireEvent.click(womenTab);
    expect(womenTab).toHaveAttribute('aria-selected', 'true');
    expect(allTab).toHaveAttribute('aria-selected', 'false');

    fireEvent.click(menTab);
    expect(menTab).toHaveAttribute('aria-selected', 'true');
  });

  it('passes category filter to the products query on /shop', () => {
    render(
      <MemoryRouter initialEntries={['/shop?category=women']}>
        <CustomersShopScreen />
      </MemoryRouter>
    );

    expect(mockUseProductsQuery).toHaveBeenCalledWith(
      expect.objectContaining({
        category: 'women',
        onlyInStock: true,
        onlyWithSellers: true,
        sort: 'ID_DESC',
      })
    );
    expect(screen.getByRole('heading', { name: /محصولات زنانه/ })).toBeInTheDocument();
    expect(screen.queryByText('فروشگاه SAINTBALA')).not.toBeInTheDocument();
  });

  it('renders PicksRailSection with shared glass cards and verifies RTL scroll behavior', () => {
    const pageData = selectHomePageData(mockHomePageData);
    const mockOnAddItem = vi.fn();

    const { container } = render(
      <MemoryRouter initialEntries={['/']}>
        <PicksRailSection
          products={pageData.picks}
          exchangeRate={pageData.exchangeRate}
          onAddItem={mockOnAddItem}
        />
      </MemoryRouter>
    );

    // Verify shared glass cards are used
    const glassCards = container.querySelectorAll('.lg-card');
    expect(glassCards.length).toBeGreaterThan(0);

    // Verify scroll buttons
    const prevBtn = screen.getByRole('button', { name: 'قبلی' });
    const nextBtn = screen.getByRole('button', { name: 'بعدی' });
    expect(prevBtn).toBeInTheDocument();
    expect(nextBtn).toBeInTheDocument();

    // Mock scrollBy on the rail container
    const railRegion = screen.getByTestId('picks-rail');
    const scrollBySpy = vi.fn();
    railRegion.scrollBy = scrollBySpy;
    Object.defineProperty(railRegion, 'clientWidth', { value: 1000, configurable: true });

    // In RTL: prev should scroll positive (towards start/right), next should scroll negative (towards subsequent/left)
    fireEvent.click(prevBtn);
    expect(scrollBySpy).toHaveBeenCalledWith(
      expect.objectContaining({
        left: 750,
        behavior: 'smooth',
      })
    );

    fireEvent.click(nextBtn);
    expect(scrollBySpy).toHaveBeenCalledWith(
      expect.objectContaining({
        left: -750,
        behavior: 'smooth',
      })
    );
  });

  it('calls addItem with discounted unitPrice and hexCode color from PicksRailSection', () => {
    // Create a simple product with known price, discount, and color for testing
    const testProduct: KickzoneGraphqlTypes.Product = {
      id: 999,
      name: 'Test Product',
      sku: 'TEST-001',
      categories: [{ id: 1, slug: 'test', name: 'Test' }],
      productInfos: [
        {
          id: 9990,
          productId: 999,
          sku: 'TEST-001',
          size: 'L',
          colors: [{ id: 1, name: 'Black', hexCode: '#121212' }],
          images: ['/test.jpg'],
        },
      ],
      sellerProducts: [
        {
          id: 99900,
          productInfoId: 9990,
          sellerId: 1,
          price: 100,
          discount: 20, // 20% discount -> 80
          stockQuantity: 5,
          seller: { id: 1, shippingFee: 0 },
        },
      ],
    } as unknown as KickzoneGraphqlTypes.Product;

    const mockOnAddItem = vi.fn();

    render(
      <MemoryRouter initialEntries={['/']}>
        <PicksRailSection
          products={[testProduct]}
          exchangeRate={270000}
          onAddItem={mockOnAddItem}
        />
      </MemoryRouter>
    );

    // Find the add to cart button - it's a full button (not IconButton) with specific text
    const addButtons = screen.getAllByRole('button');
    const addToCartButton = addButtons.find(
      (btn) =>
        btn.textContent?.includes('افزودن به سبد خرید') ||
        btn.textContent?.includes('Add to Cart') ||
        btn.getAttribute('aria-label')?.includes('افزودن به سبد')
    );
    expect(addToCartButton).toBeDefined();

    if (addToCartButton) {
      fireEvent.click(addToCartButton);
    }

    // Verify onAddItem was called with product and size (PicksRailSection callback signature)
    expect(mockOnAddItem).toHaveBeenCalledTimes(1);
    expect(mockOnAddItem).toHaveBeenCalledWith(testProduct, 'L');
  });
});
