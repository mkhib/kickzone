{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "strictPropertyInitialization": false,
    "paths": {
      "@kickzone-workspace/admins-components": [
        "libs/client/admins/components/src/index.ts"
      ],
      "@kickzone-workspace/admins-contexts": [
        "libs/client/admins/contexts/src/index.ts"
      ],
      "@kickzone-workspace/admins-router": [
        "libs/client/admins/router/src/index.ts"
      ],
      "@kickzone-workspace/colors": [
        "libs/client/shared/ui/colors/src/index.ts"
      ],
      "@kickzone-workspace/controllers": [
        "libs/server/controllers/src/index.ts"
      ],
      "@kickzone-workspace/customers-auth-context": [
        "libs/client/customers/contexts/auth/src/index.ts"
      ],
      "@kickzone-workspace/customers-headerbar": [
        "libs/client/customers/components/headerbar/src/index.ts"
      ],
      "@kickzone-workspace/customers-home-screen": [
        "libs/client/customers/screens/home/src/index.ts"
      ],
      "@kickzone-workspace/customers-layout": [
        "libs/client/customers/components/layout/src/index.ts"
      ],
      "@kickzone-workspace/customers-login-screen": [
        "libs/client/customers/screens/login/src/index.ts"
      ],
      "@kickzone-workspace/customers-router": [
        "libs/client/customers/router/src/index.ts"
      ],
      "@kickzone-workspace/customers-test-utility": [
        "libs/client/customers/utility/test/src/index.ts"
      ],
      "@kickzone-workspace/entities": ["libs/server/entities/src/index.ts"],
      "@kickzone-workspace/guards": ["libs/server/guards/src/index.ts"],
      "@kickzone-workspace/inputs": ["libs/server/inputs/src/index.ts"],
      "@kickzone-workspace/layout": [
        "libs/client/shared/components/layout/src/index.ts"
      ],
      "@kickzone-workspace/modules": ["libs/server/modules/src/index.ts"],
      "@kickzone-workspace/resolvers": ["libs/server/resolvers/src/index.ts"],
      "@kickzone-workspace/sellers-auth-context": [
        "libs/client/sellers/contexts/auth/src/index.ts"
      ],
      "@kickzone-workspace/sellers-headerbar": [
        "libs/client/sellers/components/headerbar/src/index.ts"
      ],
      "@kickzone-workspace/sellers-layout": [
        "libs/client/sellers/components/layout/src/index.ts"
      ],
      "@kickzone-workspace/sellers-login-screen": [
        "libs/client/sellers/screens/login/src/index.ts"
      ],
      "@kickzone-workspace/sellers-product-editor-screen": [
        "libs/client/sellers/screens/product-editor/src/index.ts"
      ],
      "@kickzone-workspace/sellers-products-screen": [
        "libs/client/sellers/screens/products/src/index.ts"
      ],
      "@kickzone-workspace/sellers-router": [
        "libs/client/sellers/router/src/index.ts"
      ],
      "@kickzone-workspace/services": ["libs/server/services/src/index.ts"],
      "@kickzone-workspace/strategies": ["libs/server/strategies/src/index.ts"],
      "@kickzone-workspace/utils": ["libs/server/utils/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
